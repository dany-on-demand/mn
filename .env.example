# Copy this file to .env and fill in values as needed.
# The server reads these variables at startup.

# HTTP port to listen on (default: 3016)
PORT=3016

# Set to "production" when running behind a reverse proxy (nginx/Caddy).
# Enables HTTPS-only cookies and HSTS headers. Required for security in prod.
# NODE_ENV=production

# Admin credentials (set on FIRST run only – ignored if admin already exists).
# If omitted, a random password is generated and printed to the console.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-immediately

# Secret used to sign session cookies.
# Strongly recommended in production – if omitted a random secret is
# generated and persisted in the database (survives restarts).
# SESSION_SECRET=a-long-random-string
